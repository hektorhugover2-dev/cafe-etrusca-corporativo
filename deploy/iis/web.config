        <!-- D6: 3 aditivos/gomas blog posts → HTTP 410 Gone -->
        <rewriteMap name="Gone410" defaultValue="" ignoreCase="false">
          <add key="/Blog/Detail/Qué-son-y-per-que-se-usan-las-gomas-en-productos-alimenticios" value="1" />
          <add key="/Blog/Detail/Tipos-de-aditivos-y-su-uso-en-alimentos-ya-producidos" value="1" />
          <add key="/Blog/Detail/Beneficios-y-propiedades-de-la-goma-xantana" value="1" />
        </rewriteMap>
      </rewriteMaps>
      <rules>
        <!-- Non-production hosts (desarrollo.cafeetrusca.com, IPs...): disallow-all robots.txt -->
        <rule name="NonProd robots.txt" stopProcessing="true">
          <match url="^robots\.txt$" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^(cafeetrusca\.com|www\.cafeetrusca\.com)$" negate="true" />
          </conditions>
          <action type="Rewrite" url="/robots-noindex.txt" />
        </rule>
        <!-- www.cafeetrusca.com -> cafeetrusca.com (only fires on the www host) -->
        <rule name="www to apex" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.cafeetrusca\.com$" />
          </conditions>
          <action type="Redirect" url="https://cafeetrusca.com/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- Gone: old aditivos/gomas posts answer 410 (no redirect to an unrelated page) -->
        <rule name="Gone 410" stopProcessing="true">
          <match url="^(.*?)/?$" />
          <conditions>
            <add input="{Gone410:/{R:1}}" pattern="1" />
          </conditions>
          <action type="CustomResponse" statusCode="410" statusReason="Gone" statusDescription="Gone" />
        </rule>
        <!-- Old URLs -> new URLs (301) -->
        <rule name="SEO 301 map" stopProcessing="true">
          <match url="^(.*?)/?$" />
          <conditions>
            <add input="{SeoRedirects:/{R:1}}" pattern="(.+)" />
          </conditions>
          <action type="Redirect" url="{C:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <!-- Old URLs -> new URLs (301) — case variants -->
        <rule name="SEO 301 map 2" stopProcessing="true">
          <match url="^(.*?)/?$" />
          <conditions>
            <add input="{SeoRedirects2:/{R:1}}" pattern="(.+)" />
          </conditions>
          <action type="Redirect" url="{C:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <!-- /index.html and /<page>/index.html -> the canonical folder URL (one version per page).
             Internal rewrites/ExecuteURL to /index.csr.html are not affected. -->
        <rule name="index.html to folder" stopProcessing="true">
          <match url="^(.*/)?index\.html$" />
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <!-- Past or unknown course dates /cursos-y-talleres/<slug>/ (301). /api/Event only lists upcoming
             dates and only those are prerendered, so a slug WITHOUT a prerendered folder is a date that
             already happened (or never existed). Known past dates (review + event archive) are already in
             the SEO 301 map above (course page by categoryId + sede). The rest: course page parsed from the
             slug; no course → "solicitar información" form on the cursos page. Dates created after the
             build also land here until the next build prerenders them (links inside the site still open them). -->
        <rule name="Past event emprende sede" stopProcessing="true">
          <match url="^cursos-y-talleres/([^/]+)/?$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{APPL_PHYSICAL_PATH}cursos-y-talleres\{R:1}\index.html" matchType="IsFile" negate="true" />
            <add input="{R:1}" pattern="^emprendiendo" />
            <add input="-{R:1}-" pattern="-(iztapalapa-cdmx|zona-rosa-cdmx|viaducto-cdmx|guadalajara|iztapalapa|zona-rosa|queretaro|monterrey|viaducto|tijuana|xalapa|toluca|puebla|merida|leon)-" />
            <add input="{PastEventCourse:emprende|{C:1}}" pattern="(.+)" />
          </conditions>
          <action type="Redirect" url="{C:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Past event emprende" stopProcessing="true">
          <match url="^cursos-y-talleres/([^/]+)/?$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{APPL_PHYSICAL_PATH}cursos-y-talleres\{R:1}\index.html" matchType="IsFile" negate="true" />
            <add input="{R:1}" pattern="^emprendiendo" />
          </conditions>
          <action type="Redirect" url="/emprendiendo-mi-negocio-de-barra-de-cafe-y-cafeteria/" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Past event c0 sede" stopProcessing="true">
          <match url="^cursos-y-talleres/([^/]+)/?$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{APPL_PHYSICAL_PATH}cursos-y-talleres\{R:1}\index.html" matchType="IsFile" negate="true" />
            <add input="{R:1}" pattern="^(?!emprendiendo)(?=.*(?:bubble-tea-especializado))" />
            <add input="-{R:1}-" pattern="-(iztapalapa-cdmx|zona-rosa-cdmx|viaducto-cdmx|guadalajara|iztapalapa|zona-rosa|queretaro|monterrey|viaducto|tijuana|xalapa|toluca|puebla|merida|leon)-" />
            <add input="{PastEventCourse:c0|{C:1}}" pattern="(.+)" />
