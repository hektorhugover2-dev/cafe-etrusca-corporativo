/*
  ! Link
  Link: <https://fonts.googleapis.com>; rel=preconnect
  Link: <https://fonts.gstatic.com>; rel=preconnect; crossorigin

/assets/*
  Cache-Control: public, max-age=2592000
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable

# SEO pre-migración (5-nov-2026): noindex SOLO fuera de producción. _headers acepta URLs absolutas
# con host; cafeetrusca.com no coincide con estas reglas y queda index,follow (meta del HTML).
https://desarrollo.cafeetrusca.com/*
  X-Robots-Tag: noindex, nofollow
https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

# robots.txt y sitemap.xml con caché corta (antes 1 año) para poder cambiarlos en la migración.
/robots.txt
  Cache-Control: public, max-age=3600, must-revalidate
/sitemap.xml
  Cache-Control: public, max-age=3600, must-revalidate
